{
  "name": "eze-factory",
  "version": "2.0.0",
  "description": "Eze-Factory is a flexible, high-performance state management library for React applications. It provides modular state handling through hives, enabling scalable and efficient management of simple and complex state types like primitives, arrays, forms, and nested objects without a centralized store. Built-in support for persistent storage, real-time updates, and simplified form handling makes Eze-Factory ideal for both small and large-scale applications.",
  "private": false,
  "license": "MIT",
  "author": "Owl3CM",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./lib/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm test && pnpm run typecheck && pnpm run build",
    "prepack": "pnpm run verify"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-react": "^7.25.7",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/validator": "^13.15.10",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.53.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist",
    "lib/Bees",
    "lib/Factory",
    "lib/Hives",
    "lib/Hooks",
    "lib/Presets",
    "lib/Slices",
    "lib/Ui",
    "lib/Utils",
    "lib/Validator",
    "lib/index.ts",
    "lib/index.css",
    ".agent/_index.md",
    ".agent/context",
    "AGENTS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "keywords": [
    "react",
    "state-management",
    "typescript",
    "hive",
    "factory",
    "slices",
    "reactive",
    "composable",
    "hooks",
    "forms",
    "pagination",
    "table",
    "status-management"
  ],
  "dependencies": {
    "validator": "^13.15.26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Owl3CM/Eze-Factory.git"
  },
  "bugs": {
    "url": "https://github.com/Owl3CM/Eze-Factory/issues"
  },
  "homepage": "https://github.com/Owl3CM/Eze-Factory#readme",
  "packageManager": "pnpm@10.30.2",
  "type": "module"
}
